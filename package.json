{
  "name": "conversation-relay-tac",
  "version": "1.0.0",
  "description": "Conversation Relay application built on Twilio Agent Connect",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./app": "./dist/app.js",
    "./tools": "./dist/tools/index.js",
    "./providers/*": "./dist/providers/*.js",
    "./prompts/*": "./dist/prompts/*.js",
    "./channels/*": "./dist/channels/*.js",
    "./messaging": "./dist/messaging/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc && cp src/prompts/*.md dist/prompts/",
    "dev": "tsx watch src/index.ts | pino-pretty"
  },
  "dependencies": {
    "@datastax/langflow-client": "^0.4.1",
    "@openai/agents": "^0.3.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.4",
    "googleapis": "^148.0.0",
    "openai": "^4.73.1",
    "twilio": "^5.13.1",
    "twilio-agent-connect": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.4.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.1.6"
  }
}

# ─── Twilio Agent Connect (required) ───
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+1xxxxxxxxxx
TWILIO_CONVERSATION_CONFIGURATION_ID=

# ─── Twilio Agent Connect (optional) ───
# Memory store ID is auto-fetched from the Conversation Configuration in 1.0.0+,
# so MEMORY_STORE_ID is no longer needed here.
# TWILIO_MEMORY_PROFILE_TRAIT_GROUPS=Contact
# TWILIO_VOICE_PUBLIC_DOMAIN=

# Memory recall strategy (template-level setting, default: always):
#   always       - call Memory Recall before every inbound message (TAC native)
#   never        - never auto-recall; LLM gets no memory context
#   first-prompt - recall once per conversation, reuse for subsequent turns
#                  (cuts Memory API cost on long conversations). For VOICE
#                  this also pre-fetches recall on the ConversationRelay
#                  `setup` event — i.e. in parallel with the welcome greeting
#                  — so the first response is faster by the recall round-trip
#                  (typically 400-1000 ms saved on the first turn).
# MEMORY_RECALL_MODE=always

# Per-conversation messaging debounce window (default 2000ms). When customers
# type multiple messages in quick succession ("oi" then "preciso de ajuda"),
# they're combined into one LLM turn instead of triggering two replies.
# Voice is never debounced. Drop to 1500 if 2s feels slow.
# MESSAGE_DEBOUNCE_MS=2000

# ─── Inbound media handling (audio transcription via Whisper) ───
# Conversation Orchestrator drops media attachments — only text bodies enter
# the conversation. Enabling this registers a Programmable Messaging webhook
# at INBOUND_MEDIA_ROUTE_PATH (default /inbound-message). Configure your
# WhatsApp Sender's "Webhook URL for incoming messages" to point at it.
# Audio messages get transcribed via Whisper and inserted as customer
# Communications so CI operators run on them.
# Off by default — opt in only when needed.
# INBOUND_MEDIA_ENABLED=false
# INBOUND_MEDIA_ROUTE_PATH=/inbound-message
# Audio (Whisper)
# WHISPER_MODEL=whisper-1
# WHISPER_LANGUAGE=pt
# Images (vision model). IMAGE_DESCRIPTION_PROMPT lets the deployment tailor
# the prompt to its domain (pharma, retail, insurance, etc.).
# VISION_MODEL=gpt-4o-mini
# IMAGE_DESCRIPTION_PROMPT=

# ─── Twilio TaskRouter (for Flex handoff) ───
TWILIO_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Studio Handoff Flow ───
# Required by createStudioHandoffTool. Single Studio Flow handles both voice
# (incomingCall trigger) and messaging (REST API trigger).
# TWILIO_STUDIO_HANDOFF_FLOW_SID=FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OpenAI ───
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MAX_COMPLETION_TOKENS=150

# ─── LLM Provider ───
# Options: openai-chat-completions (default), openai-responses, openai-agents, langflow
# LLM_PROVIDER=openai-chat-completions
# LLM_MODEL=gpt-4.1

# ─── Langflow (only when LLM_PROVIDER=langflow) ───
# The flow itself owns prompt, tools, and knowledge. TAC injects memory and
# channel context by prepending it to the user prompt before each turn.
# See LANGFLOW_PROVIDER_PLAN.md for the full integration shape + limitations.
#
# Voice quality requires turning on streaming in the model component inside
# your flow (open the flow -> click the model component -> controls ->
# turn both Stream switches on). Without that, tokens arrive in one batch
# and ConversationRelay's TTS won't start until the LLM finishes generating.
# LANGFLOW_BASE_URL=http://localhost:7860
# LANGFLOW_FLOW_ID=
# LANGFLOW_API_KEY=

# ─── Google APIs (optional) ───
# GOOGLESHEETS_SPREADSHEET_ID=
# GOOGLE_CALENDAR_ID=

# ─── Messaging Mode ───
# Options: maestro (default), conversations-v1 (for Flex handoff support)
# MESSAGING_MODE=maestro

# ─── Conversations v1 (required when MESSAGING_MODE=conversations-v1) ───
# TWILIO_CONVERSATIONS_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Enterprise Knowledge (optional) ───
# Knowledge Base IDs for each domain. Format: know_knowledgebase_*
# KB_FAQ_ID=
# KB_BILLING_ID=
# KB_DRIVER_ID=

# ─── Server ───
# PORT=3000

# ─── Welcome Greeting ───
# WELCOME_GREETING=Thanks for calling! How can I help you today?
